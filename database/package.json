{
  "name": "conservation-prioritization-db",
  "version": "0.0.0",
  "description": "Database migrations/seeding for Conservation Prioriziation Tool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/conservation-prioritization"
  },
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 10.0.0"
  },
  "scripts": {
    "setup": "npm-run-all -l -s migrate-latest seed",
    "migrate-latest": "node -r ts-node/register/transpile-only node_modules/knex/bin/cli.js migrate:latest --knexfile ./src/knexfile.ts",
    "migrate-rollback": "node -r ts-node/register/transpile-only node_modules/knex/bin/cli.js migrate:rollback --knexfile ./src/knexfile.ts",
    "seed": "node -r ts-node/register/transpile-only node_modules/knex/bin/cli.js seed:run --knexfile ./src/knexfile.ts",
    "lint": "eslint src/",
    "lint-fix": "npm run lint -- --fix",
    "format": "prettier --log-level=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --log-level=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "dependencies": {
    "@swc/core": "^1.11.7",
    "knex": "^2.4.2",
    "pg": "^8.7.1",
    "typescript": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "yarn@4.11.0",
  "resolutions": {
    "minimatch@npm:^10.2.4": "^11.0.4",
    "minimatch@npm:^10.2.6": "^11.0.4",
    "minimatch@npm:^10.2.2": "^11.0.4"
  }
}

# Dockerfile.worker
# Base image with Python and GDAL
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.3 AS build

# Copy uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN mkdir -p /home/app \
    && mkdir -p /tmp/.prefect \
    && mkdir -p /tmp/.config/matplotlib \
    && chmod -R 777 /home/app /tmp/.prefect /tmp/.config/matplotlib

WORKDIR /home/app

# Set Python path to find src package (current directory is workflows root)
ENV PYTHONPATH="/home/app:${PYTHONPATH}"

# The GDAL base image ships Python 3.14, but the locked dependencies (zarr 2 needs
# numcodecs <0.16) support Python 3.12. uv installs a managed Python 3.12 under
# /opt/python so the runtime stage can copy it alongside the virtualenv.
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON=3.12 \
    UV_PYTHON_PREFERENCE=only-managed
# uv manages all packages, the virtualenv has no pip, and nothing installs packages
# at runtime. Remove the interpreter's preinstalled pip and its ensurepip wheel,
# along with the outdated libraries vendored inside them.
RUN uv python install 3.12 \
    && rm -rf /opt/python/*/lib/python3.12/ensurepip/_bundled \
              /opt/python/*/lib/python3.12/site-packages/pip \
              /opt/python/*/lib/python3.12/site-packages/pip-*.dist-info \
              /opt/python/*/bin/pip /opt/python/*/bin/pip3*

# Some dependencies have no prebuilt arm64 wheels and compile from source (local
# Apple Silicon builds). numcodecs 0.15 bundles C code that predates C23, which
# GCC 15 in this base image uses by default, so compile C extensions as C17.
ENV CFLAGS="-std=gnu17"

# Install build deps needed to compile geospatial wheels on arm64 + py312
# - python3-dev provides Python.h
# - python3-venv ensures venv tooling exists
# - pkg-config helps builds locate libs
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      pkg-config \
      python3 \
      python3-dev \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Copy Python project files first for layer caching.
# The uv cache id includes the GDAL version: packages compiled from source link
# against the base image's libgdal, so a new base image needs a fresh cache.
COPY pyproject.toml uv.lock ./

# Install dependencies only (no project yet)
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-gdal-3.13.3 \
    uv sync --locked --no-dev --no-install-project

# Copy only the runtime project files.
COPY src ./src
COPY README.md prefect.yaml ./

# Install the project into the venv (and any editable/build steps)
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-gdal-3.13.3 \
    uv sync --locked --no-dev --no-editable

FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.3 AS runtime

# Apply OS security updates published since the base image was built, and remove
# Pebble, the Ubuntu base image's service manager, which this image never runs.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/pebble

WORKDIR /home/app
# The virtualenv's interpreter links to the managed Python 3.12 from the build stage.
COPY --from=build /opt/python /opt/python
COPY --from=build /home/app/.venv /home/app/.venv
COPY --from=build /home/app/src /home/app/src
COPY prefect.yaml ./

ENV PYTHONPATH="/home/app"
RUN mkdir -p /tmp/.prefect /tmp/.config/matplotlib \
    && chmod 777 /home/app /tmp/.prefect /tmp/.config/matplotlib

# Add virtualenv to PATH (should be last)
ENV PATH="/home/app/.venv/bin:$PATH"

# (Optional) sanity check
RUN python - <<'EOF'
import rioxarray
import xarray as xr
print("✓ imports ok")
EOF

# Run as a non-root user. Writable paths above are world-writable for OpenShift's
# arbitrary UIDs.
USER 1001
